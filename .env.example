# From `python -m tinytuya wizard` (see README)
DEVICE_ID=
DEVICE_IP=
LOCAL_KEY=
TUYA_VERSION=3.5

# Login for the web app (it is exposed through Cloudflare Tunnel)
APP_PASSWORD=change-me
# Any long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Data point numbers - confirm with scan.py once the feeder is on
DP_MEAL_PLAN=1
DP_MANUAL_FEED=2
MANUAL_FEED_MODE=trigger
DP_FEED_STATE=
DP_FAULT=
DP_FEED_REPORT=14
